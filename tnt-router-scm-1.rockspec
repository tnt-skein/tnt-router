rockspec_format = '3.0'

package = 'tnt-router'
version = 'scm-1'

source = {
    url = 'git+https://github.com/tnt-skein/tnt-router.git',
    branch = 'main',
}

description = {
    summary = 'Маршрутизация HTTP-запросов: адрес — обработчик',
    detailed = [[
        Объявление маршрутов по способам и группами с общим началом пути
        и общими слоями, параметры пути с ограничениями, хвост для раздачи
        файлов, именованные маршруты и построение адреса по имени:
        путь, полный адрес от адреса приложения, подписанная ссылка
        со сроком и слой её сверки, канонический адрес страницы.

        Поиск идёт по дереву участков пути, а не перебором шаблонов:
        постоянный участок важнее параметра, параметр с ограничением —
        параметра без него. Несовпавшее ограничение даёт 404, а не 500.

        Запрос и ответ — обычные таблицы, поэтому роутер проверяется
        без сервера. Поверх http.server он ставится одним вызовом attach:
        тело запроса читается с пределом и сроком, форма и присланные
        файлы разбираются потоком, ответ уходит строкой либо кусками,
        а ответ со сменой протокола отдаёт соединение обработчику.

        Раздача файлов из каталога или из памяти процесса: тип по
        расширению, метка версии и ответ 304, срок жизни копии, большие
        файлы кусками, запасная страница одностраничного приложения;
        переход вверх по дереву, скрытые файлы и ссылки наружу
        не отдаются.

        Отказы 404, 405, 500 и отказы тела роутер отвечает сам, в JSON
        и с опознавателем происшествия; свой обработчик отказов
        подставляется одним вызовом. Каждый ответ ложится в ряды метрик:
        запросы по способу, шаблону маршрута и коду и длительность
        ответа; запрос без маршрута идёт словом _unmatched, и путь
        сканера меток не разращивает.

        Необязательные соседи берутся по имени, если стоят: tnt-validate
        проверяет ограничения параметров, tnt-middleware разворачивает
        слои, названные именем. Без них роутер проверяет ограничения
        запасными образцами и принимает слоями только функции.
    ]],
    homepage = 'https://github.com/tnt-skein/tnt-router',
    issues_url = 'https://github.com/tnt-skein/tnt-router/issues',
    maintainer = 'tnt-skein',
    license = 'MIT',
    labels = { 'tarantool', 'http', 'router', 'routing', 'static-files', 'signed-url' },
}

dependencies = {
    'lua >= 5.1',
    -- Сервер, на который роутер ставится; раздача берёт у него таблицу
    -- типов содержимого, а не держит свою копию.
    'http',
    -- Бросок без места: отказы шаблона, дерева и маршрута, которым место
    -- приписывает вход роутера, повторный выброс исключения группы и обрыв
    -- потока; проверка аргументов адресов и подписи с виной на вызывающем.
    'tnt-must',
    -- Подпись ссылок: HMAC-SHA256 и сверка за постоянное время. Своя
    -- свёртка поверх `crypto` в пакете была бы вторым местом для того же,
    -- и сравнение `==` в нём однажды появилось бы.
    'tnt-hash',
    -- Срок на чтение тела кусками: миг окончания отмечается настоящими
    -- часами, а остаток, уходящий в ожидание сокета, — временем
    -- планировщика. Своей пары часов у пакета быть не должно. Ими же
    -- меряется, сколько шёл поток ответа.
    'tnt-clock',
    -- Контекст запроса на теле потока: сервер обходит тело, когда слои
    -- входа уже вышли из своих областей, и без снимка запись об обрыве
    -- осталась бы без опознавателей запроса и трассы.
    'tnt-context',
    -- Даты HTTP у раздачи: `Last-Modified` пишется одним видом
    -- (IMF-fixdate), а `If-Modified-Since` читается тремя, как велит
    -- RFC 9110. Второе место разбора дат разошлось бы с первым молча —
    -- по той же причине, по какой таблица типов берётся у рока.
    'tnt-date',
    -- Азбука Крокфорда для опознавателя происшествия: восемь знаков,
    -- которые человек диктует дежурному по телефону без ошибок.
    'tnt-id',
    -- Журнал отказов: подробности отказа уходят сюда, а не в ответ.
    'tnt-log',
    -- Файлы: присланный файл пишется писателем кусками, раздача читает
    -- большой файл читателем, ссылка опрашивается без раскрытия. Отказ
    -- диска у всех трёх — пара с родом, а не свой текст у каждого места.
    'tnt-fs',
    -- Подмена часов, случайности и подключения соседей в проверках.
    'tnt-external',
    -- Ряды границы HTTP: запросы по способу, маршруту и коду, длительность.
    'tnt-metrics',
    -- Необязательно и здесь не объявлено: `tnt-validate` проверяет
    -- ограничения параметров пути, `tnt-middleware` разворачивает слои,
    -- названные именем. Роутер берёт их по имени, если они стоят.
}

build = {
    type = 'builtin',
    modules = {
        ['tnt.router'] = 'tnt/router.lua',
        ['tnt.router.address'] = 'tnt/router/address.lua',
        ['tnt.router.answer'] = 'tnt/router/answer.lua',
        ['tnt.router.blame'] = 'tnt/router/blame.lua',
        ['tnt.router.constraints'] = 'tnt/router/constraints.lua',
        ['tnt.router.declare'] = 'tnt/router/declare.lua',
        ['tnt.router.errors'] = 'tnt/router/errors.lua',
        ['tnt.router.etag'] = 'tnt/router/etag.lua',
        ['tnt.router.files'] = 'tnt/router/files.lua',
        ['tnt.router.files.caching'] = 'tnt/router/files/caching.lua',
        ['tnt.router.files.store'] = 'tnt/router/files/store.lua',
        ['tnt.router.form'] = 'tnt/router/form.lua',
        ['tnt.router.multipart'] = 'tnt/router/multipart.lua',
        ['tnt.router.neighbour'] = 'tnt/router/neighbour.lua',
        ['tnt.router.options'] = 'tnt/router/options.lua',
        ['tnt.router.path'] = 'tnt/router/path.lua',
        ['tnt.router.pipeline'] = 'tnt/router/pipeline.lua',
        ['tnt.router.request'] = 'tnt/router/request.lua',
        ['tnt.router.response'] = 'tnt/router/response.lua',
        ['tnt.router.series'] = 'tnt/router/series.lua',
        ['tnt.router.signed'] = 'tnt/router/signed.lua',
        ['tnt.router.takeover'] = 'tnt/router/takeover.lua',
        ['tnt.router.tree'] = 'tnt/router/tree.lua',
        ['tnt.router.upload'] = 'tnt/router/upload.lua',
        ['tnt.router.view'] = 'tnt/router/view.lua',
    },
}
